# ─── Firebase — copier ce fichier en .env.local et remplir ───
# Récupérer les valeurs : Firebase Console → Paramètres du projet →
# Vos applications → Configuration du SDK.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Google Places (vrais avis Google) ───
# Clé API côté serveur (NE PAS préfixer par NEXT_PUBLIC_).
# Google Cloud Console → APIs & Services → Credentials.
# Activez « Places API (New) ».
GOOGLE_PLACES_API_KEY=
# Place ID de l'établissement :
#   https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_PLACE_ID=

# ─── SEO : URL canonique du site ───
# Domaine de production : https://www.osnacktorcy.fr (Vercel — l'hôte
# canonique est le www, osnacktorcy.fr redirige en 308 vers le www).
# Cette valeur alimente canonical, Open Graph, JSON-LD, robots.txt et
# sitemap.xml. Le fallback code est identique (lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://www.osnacktorcy.fr
