rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ADMIN UNIQUE : le compte claytonmicillo2009@gmail.com (UID ci-dessous).
     * Tous les autres comptes Auth sont des CLIENTS : ils ne voient que
     * leur espace fidélité /compte. Pour changer d'admin, remplace l'UID
     * (Console → Authentication → Users) et redéploie les règles.
     */
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'w3uqTf4xDRcgvJlIwaqTpGm8I2E2';
    }

    // Menu public agrégé en UN document (lecture : cache ISR serveur).
    match /menu/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection historique (avant agrégation) — en lecture publique pour
    // compatibilité, mais plus utilisée par le site.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Commandes : réservées à l'admin unique
    // (écoute temps réel du dashboard cuisine).
    match /orders/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false; // conservation des commandes
    }

    // ---- Programme fidélité (codes remis au comptoir) ----

    // Profil fidélité : chaque client ne voit et ne modifie que le sien.
    // La transaction `redeemCode` (client) y écrit points/updatedAt.
    match /loyalty_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Codes : un client authentifié peut lire un code (pour le valider) et
    // le marquer utilisé via la transaction — mais jamais en créer ni
    // réactiver un code déjà consommé. La création reste côté admin.
    match /loyalty_codes/{code} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.status == 'available'
        && request.resource.data.points is number
        && request.resource.data.points >= 0;
      allow update: if request.auth != null
        && resource.data.status == 'available'
        && request.resource.data.status == 'redeemed'
        && request.resource.data.points == resource.data.points
        && request.resource.data.code == resource.data.code;
      allow delete: if false; // un code utilisé reste tracé
    }

    // Refuse tout le reste par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
