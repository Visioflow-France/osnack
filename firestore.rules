rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ADMIN UNIQUE : le compte claytonmicillo2009@gmail.com (UID ci-dessous).
     * Tous les autres comptes Auth sont des CLIENTS : ils ne voient que
     * leur espace fidélité /compte. Pour changer d'admin, remplace l'UID
     * (Console → Authentication → Users) et redéploie les règles.
     */
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'w3uqTf4xDRcgvJlIwaqTpGm8I2E2';
    }

    // Menu public agrégé en UN document (lecture : cache ISR serveur).
    match /menu/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection historique (avant agrégation) — en lecture publique pour
    // compatibilité, mais plus utilisée par le site.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Commandes : réservées à l'admin unique
    // (écoute temps réel du dashboard cuisine).
    match /orders/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false; // conservation des commandes
    }

    // Espace client fidélité : chaque client ne peut lire que SON document
    // profil et SON historique. Les crédits/débits de points sont faits par
    // l'admin (comptoir) — le client ne peut pas s'auto-créditer.
    match /customers/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      // Le client crée SON profil vierge ; l'admin peut créer le profil
      // d'un client enregistré au comptoir.
      allow create: if request.auth != null && request.resource.data.points == 0
                    && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;

      match /history/{entryId} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Refuse tout le reste par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
