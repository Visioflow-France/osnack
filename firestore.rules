rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ADMIN UNIQUE : le compte visioflow77@gmail.com (UID ci-dessous).
     * Tous les autres comptes Auth sont des CLIENTS : ils ne voient que
     * leur espace fidélité /compte. Pour changer d'admin, remplace l'UID
     * (Console → Authentication → Users) et redéploie les règles.
     */
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'Fqbbqe5i2qdp3g7zuOT6Hpxv6aC3';
    }

    // Slides du carrousel de catégories (page d'accueil) : lecture publique,
    // écriture admin. Les docs n'existent pas tant que l'admin n'a rien changé —
    // le site retombe alors sur les valeurs par défaut du code.
    match /home_slides/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Réglages du site (réseaux sociaux, Uber Eats, Deliveroo…) : doc unique
    // `site_settings/links`, lecture publique (écoute temps réel du site),
    // écriture admin uniquement. Champ vide = retour à la valeur par défaut.
    match /site_settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu vitrine : lecture publique (API /api/menu côté serveur, cache ISR),
    // écriture admin uniquement.
    match /menu/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Programme fidélité ----

    // Profil fidélité : chaque client ne voit et ne modifie que le sien
    // (transaction redeemCode côté client). L'ADMIN écrit aussi pour créditer
    // automatiquement les points des commandes web à la livraison
    // (lib/orderDelivery.ts — transaction livree + points).
    match /loyalty_users/{uid} {
      allow read, write: if isAdmin()
                         || (request.auth != null && request.auth.uid == uid);
    }

    // Codes : un client authentifié peut lire un code (pour le valider) et
    // le marquer utilisé via la transaction — mais jamais en créer ni
    // réactiver un code déjà consommé. La création reste côté admin.
    match /loyalty_codes/{code} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.status == 'available'
        && request.resource.data.points is number
        && request.resource.data.points >= 0;
      allow update: if request.auth != null
        && resource.data.status == 'available'
        && request.resource.data.status == 'redeemed'
        && request.resource.data.points == resource.data.points
        && request.resource.data.code == resource.data.code;
      allow delete: if false; // un code utilisé reste tracé
    }

    // ---- Commandes (web « payer au retrait » + comptoir) ----
    //
    // Lecture / modification / suppression : ADMIN uniquement — aucun suivi
    // public (la confirmation client est de l'état navigateur), donc zéro
    // lecture Firestore visiteur.
    //
    // Création : admin libre (commandes comptoir / téléphone) OU visiteur
    // avec un payload web STRICTEMENT validé. Le client n'envoie que des
    // sélections ; les rules bornent la forme (types, tailles, quantités) —
    // elles ne peuvent pas recalculer Σ price×qty : le contrôle EXACT du
    // total est refait côté dashboard admin (lib/orderCheck.ts).
    match /orders/{id} {
      allow read, update, delete: if isAdmin();

      allow create: if isAdmin()
        || (
          request.resource.data.keys().hasOnly([
            'reference','status','channel','customerName','customerPhone',
            'customerEmail','uid','pickup','note','items','total','createdAt',
            'paidWithPoints','pointsSpent'
          ])
          && request.resource.data.status == 'nouvelle'
          && request.resource.data.channel == 'web'
          && request.resource.data.reference is string
          && request.resource.data.reference.matches('W-[A-Z0-9]{4,8}')
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() >= 1
          && request.resource.data.customerName.size() <= 40
          && request.resource.data.customerPhone is string
          && request.resource.data.customerPhone.matches('[0-9+ .()-]{6,20}')
          && (!('customerEmail' in request.resource.data)
              || (request.resource.data.customerEmail is string
                  && request.resource.data.customerEmail.size() <= 80))
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 300))
          // uid : absent (invité) OU égal à l'uid authentifié (anti-usurpation).
          // Une commande avec cadeaux points (paidWithPoints) exige un compte :
          // le débit du solde fidélité se fait dans la même transaction client.
          && (
            (request.auth == null && !('uid' in request.resource.data))
            || (request.auth != null
                && 'uid' in request.resource.data
                && request.resource.data.uid == request.auth.uid)
          )
          // Cadeaux points : flag booléen vrai + total de points débités borné.
          && (!('paidWithPoints' in request.resource.data)
              || request.resource.data.paidWithPoints == true)
          && (!('pointsSpent' in request.resource.data)
              || (request.resource.data.pointsSpent is int
                  && request.resource.data.pointsSpent >= 1
                  && request.resource.data.pointsSpent <= 100000
                  && request.resource.data.paidWithPoints == true))
          // Retrait : ASAP (sans date) ou créneau programmé plausible
          // (entre -15 min et +7 j — tolère l'horloge cliente qui dérive).
          && request.resource.data.pickup is map
          && request.resource.data.pickup.keys().hasOnly(['mode','at'])
          && (
            (request.resource.data.pickup.mode == 'asap'
             && !('at' in request.resource.data.pickup))
            || (request.resource.data.pickup.mode == 'scheduled'
                && request.resource.data.pickup.at is number
                && request.resource.data.pickup.at > request.time.toMillis() - 900000
                && request.resource.data.pickup.at < request.time.toMillis() + 604800000)
          )
          // Articles : 1 à 40 lignes, champs bornés.
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 40
          && request.resource.data.items.all(x,
               x is map
               && x.keys().hasOnly(['productId','name','qty','price','variant','options','optionsSummary','paidWithPoints','pointsSpent'])
               && x.productId is string
               && x.productId.size() >= 1
               && x.productId.size() <= 40
               && x.name is string
               && x.name.size() >= 1
               && x.name.size() <= 60
               && x.qty is int
               && x.qty >= 1
               && x.qty <= 30
               && x.price is number
               && x.price >= 0
               && x.price <= 100
               && (!('variant' in x) || x.variant == 'menu')
               && (!('optionsSummary' in x)
                   || (x.optionsSummary is string && x.optionsSummary.size() <= 160))
               && (!('options' in x)
                   || (x.options is list
                       && x.options.size() <= 8
                       && x.options.all(o,
                            o is map
                            && o.keys().hasOnly(['label','price'])
                            && o.label is string
                            && o.label.size() <= 60
                            && o.price is number
                            && o.price >= 0
                            && o.price <= 10)))
               // Cadeau fidélité : flag vrai, prix 0 €, 1 seul exemplaire et
               // palier de points débités explicite (revérifié côté dashboard
               // contre GIFT_TIERS — lib/orderCheck.ts).
               && (!('paidWithPoints' in x) || x.paidWithPoints == true)
               && (!('pointsSpent' in x)
                   || (x.pointsSpent is int
                       && x.pointsSpent >= 1
                       && x.pointsSpent <= 100000
                       && x.paidWithPoints == true))
               && (!('paidWithPoints' in x)
                   || (x.price == 0 && x.qty == 1 && ('pointsSpent' in x)))
             )
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= 1000
          && request.resource.data.createdAt is number
          && request.resource.data.createdAt > request.time.toMillis() - 600000
          && request.resource.data.createdAt < request.time.toMillis() + 600000
        );
    }

    // Refuse tout le reste par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
