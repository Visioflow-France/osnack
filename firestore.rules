rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Menu public en lecture pour tout le monde ;
    // écriture réservée aux utilisateurs authentifiés (l'admin).
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---- Programme fidélité ----

    // Profil fidélité : chaque client ne voit et ne modifie que le sien.
    // La transaction `redeemCode` (client) y écrit points/updatedAt ; le
    // restaurant n'a pas besoin d'y toucher directement.
    match /loyalty_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Codes : un client authentifié peut lire un code (pour le valider) et
    // le marquer utilisé via la transaction — mais jamais en créer ni
    // réactiver un code déjà consommé. La création reste côté admin
    // (restaurant authentifié).
    match /loyalty_codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.status == 'available'
        && request.resource.data.points is number
        && request.resource.data.points >= 0;
      allow update: if request.auth != null
        && resource.data.status == 'available'
        && request.resource.data.status == 'redeemed'
        && request.resource.data.points == request.resource.data.points
        && request.resource.data.code == resource.data.code;
      allow delete: if false; // un code utilisé reste tracé
    }

    // Refuse tout le reste par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
