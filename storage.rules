rules_version = '2';

// Firebase Storage — images des plats (WebP compressés ≤ 150 Ko).
// Téléchargement public (affichage du menu), upload/suppression réservés
// à l'admin authentifié. La limite de 5 Mo laisse une marge confortable
// au-dessus des ~150 Ko réels (compression côté client).
service firebase.storage {
  match /b/{bucket}/o {
    match /dishes/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
